{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "wyrm",
      "camelcase": "Wyrm",
      "title": "Wyrm",
      "scope": "source.wyrm",
      "path": ".",
      "file-types": ["wy", "wyrm"],
      "injection-regex": "^wyrm$",
      "highlights": "queries/highlights.scm"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Wyrm grammar for tree-sitter",
    "authors": [{ "name": "Andrew Mulbrook" }],
    "links": { "repository": "https://github.com/Wyrm-Language/tree-sitter-wyrm" }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}
