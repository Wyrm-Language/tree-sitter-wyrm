{
  "name": "tree-sitter-wyrm",
  "version": "0.1.0",
  "description": "Tree-sitter grammar for the Wyrm scripting language",
  "repository": "https://github.com/wyrm-language/tree-sitter-wyrm",
  "license": "MIT",
  "author": {
    "name": "Andrew Mulbrook"
  },
  "main": "bindings/node",
  "types": "bindings/node",
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "wyrm"
  ],
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "src/**",
    "*.wasm"
  ],
  "dependencies": {
    "node-addon-api": "^8.5.0",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "prebuildify": "^6.0.1",
    "tree-sitter": "^0.22.4",
    "tree-sitter-cli": "^0.25.10"
  },
  "peerDependencies": {
    "tree-sitter": "^0.22.4"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "scripts": {
    "install": "node-gyp-build",
    "generate": "tree-sitter generate",
    "test": "tree-sitter test && node --test bindings/node/*_test.js",
    "test:corpus": "tree-sitter test",
    "prestart": "tree-sitter build --wasm",
    "start": "tree-sitter playground"
  }
}
